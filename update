
/* ============================
   HERO SECTION
============================ */

.hero {
    padding: 120px 24px;          /* vertical | horizontal */
    text-align: center;
    color: #fff;
    background: url("/img gym/IMG_8408.JPG") no-repeat center center;
    background-size: cover;
    border-radius: 16px;
    position: relative;
}

/* Optional dark overlay for readability */
.hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.45);
    border-radius: 16px;
}

.hero > * {
    position: relative;
    z-index: 2;
}

.hero h1 {
    font-size: 2.4rem;
    color: var(--green);
    max-width: 900px;
    margin: 0 auto;
}

.hero p {
    max-width: 720px;
    margin: 14px auto;
    font-size: 1.05rem;
    line-height: 1.6;
}

/* Mobile Fix */
@media (max-width: 600px) {
    .hero {
        padding: 80px 16px;
    }

    .hero h1 {
        font-size: 1.8rem;
    }

    .hero p {
        font-size: 0.95rem;
    }
}
